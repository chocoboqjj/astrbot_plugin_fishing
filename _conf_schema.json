        "default": 7777
      }
    }
  },
  "tax": {
    "description": "税收系统配置",
    "type": "object",
    "items": {
      "is_tax": {
        "description": "是否启用税收",
        "type": "bool",
        "hint": "税收的开关",
        "default": true
      },
      "threshold": {
        "description": "税收的起征点",
        "type": "int",
        "hint": "持有金币低于此值不收税。当前 1000 万，约等于区域4满配 12 天产出，让绝大多数玩家不受影响",
        "default": 10000000,
        "min": 0
      },
      "step_coins": {
        "description": "税收的步长",
