        "default": 0.7,
        "min": 0.0,
        "max": 1.0
      },
      "rare_chance_transfer_factor": {
        "description": "稀有度权重转移系数",
        "type": "float",
        "hint": "加成把低星权重转移到高星时的强度。越大越容易出高星鱼，建议 0.5~2.0",
        "default": 1.0,
        "min": 0.0,
        "max": 10.0
      },
      "rare_chance_max_boost": {
        "description": "稀有鱼加成的最大生效比例",
        "type": "float",
        "hint": "所有稀有鱼加成叠加后的封顶值。注意：装备满配稀有可达0.92（鱼竿0.15+饰品0.05+10级精炼0.72），上限不应低于该值，否则精炼9~10级将无收益",
        "default": 1.0,
        "min": 0.0,
        "max": 2.0
      },
      "garbage_fish_value_threshold": {
        "description": "垃圾鱼判定阈值",
        "type": "int",
        "hint": "基础价值低于该值的鱼视为垃圾鱼，可被「驱散垃圾饵」等道具修正",
        "default": 5,
        "min": 0
      }
    }
  },
