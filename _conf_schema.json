      "quality_bonus_max_chance": {
        "description": "高品质鱼最大触发概率",
        "type": "float",
        "hint": "装备品质加成触发高品质鱼的概率上限",
        "default": 0.35,
        "min": 0.0,
        "max": 1.0
      },
      "quality_chance_scale": {
        "description": "高品质概率压缩系数",
        "type": "float",
        "hint": "实际概率 = log2(品质倍率) × 本系数，并被上限封顶。调高可让品质加成更强（默认0.5）",
        "default": 0.5,
        "min": 0.05,
        "max": 2.0
      },
      "base_success_rate": {
        "description": "钓鱼基础成功率",
