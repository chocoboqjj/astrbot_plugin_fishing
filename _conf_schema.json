        "default": 0.05,
        "min": 0.0,
        "max": 1.0
      }
    }
  },
  "fishing": {
    "description": "钓鱼系统配置",
    "type": "object",
    "items": {
      "cost": {
        "description": "钓鱼的默认花费",
        "type": "int",
